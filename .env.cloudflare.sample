# ---------------------------------------------------------------------------
# Cloudflare deployment credentials + Worker secrets.
#
# Copy this file to `.env.cloudflare` and fill it in. That copy is gitignored;
# this sample is the only version that is committed, so never put a real value
# here.
#
# Everything in this file is consumed by `scripts/cf-setup.mjs`:
#   - CLOUDFLARE_* authenticate wrangler and the Cloudflare REST API
#   - every other key is uploaded as a Worker *secret* (encrypted at rest,
#     invisible in the dashboard after upload) — they are NOT put in
#     wrangler.jsonc, which is committed
#
# Blank values are skipped, not uploaded as empty strings. Existing secrets are
# left untouched when the key is blank here.
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------

# Cloudflare API token. Create at:
#   https://dash.cloudflare.com/profile/api-tokens -> Create Token
# Start from the "Edit Cloudflare Workers" template, then ADD two permissions
# so the same token can also move the domain onto Cloudflare:
#
#   Account | Workers Scripts        | Edit    (from the template)
#   Account | Account Settings       | Read    (from the template)
#   Account | Workers Tail           | Read    (from the template; `wrangler tail`)
#   Zone    | Workers Routes         | Edit    (from the template)
#   Zone    | Zone                   | Edit    <- add (creates the zone)
#   Zone    | DNS                    | Edit    <- add (custom domain record)
#
#   Account Resources: Include -> <your account>
#   Zone Resources:    Include -> All zones from an account -> <your account>
#
# Leave the TTL unrestricted and the IP filter empty unless you have a static
# IP. Copy the token once — Cloudflare never shows it again.
CLOUDFLARE_API_TOKEN=

# Optional. Auto-discovered from the token when left blank (needs the
# "Account Settings: Read" permission above). Set it explicitly only if the
# token can see more than one account.
CLOUDFLARE_ACCOUNT_ID=

# --- Worker secrets -------------------------------------------------------
# Same meanings as .env.sample — see that file for how to obtain each one.
# These are uploaded to the Worker, so the deployed site can read them.

# Self-hosted cobalt instance(s), comma- or space-separated. Falls back to the
# public instance when unset. Must include the trailing slash.
COBALT_API_URL=

# Only if your cobalt instance has API_AUTH_REQUIRED=1.
COBALT_API_KEY=

# Last-resort page fetch for sites that wall datacenter IPs (they answer a
# Worker with a ~369-byte redirect stub while a residential IP gets the real
# markup). The block is on datacenter ranges in general, so a VPS or a
# self-hosted extractor is walled the same way; only
# egress from a residential pool changes the answer, which means a third-party
# unlocker with an HTTPS API — Workers `fetch` cannot use an ordinary proxy.
#
# Any endpoint that returns the page's markup works. Put its request URL here
# with {url} where the target goes.
#
# Free: deploy/resolver serves exactly this at /html. Host it anywhere that is
# not Cloudflare — a free tier such as Koyeb or Back4app, or a machine at home
# behind a tunnel — and point this at it. See that README.
#   SCRAPE_UNLOCKER_URL=https://<resolver-host>/html?key=KEY&url={url}
#
# Or a paid unlocker, which is the same shape and bills per request:
#   SCRAPE_UNLOCKER_URL=https://api.provider.example/?api_key=KEY&url={url}
#
# NOTE (measured): the free relays built into the extractor — a reader service,
# the Internet Archive, and a public CORS proxy — all refuse requests coming
# from a Cloudflare Worker, though all three answer a residential connection.
# So this variable is what completes the blocked path, and it must point at
# something whose egress is NOT Cloudflare.
SCRAPE_UNLOCKER_URL=

# Per-host recipes for sites whose watch page is walled but whose embed is not.
# JSON array; see src/lib/siteRules.ts for the field meanings. Kept out of the
# repo deliberately — which hosts a deployment works around is not the public
# repository's business, and a host that changes its markup is repaired by
# editing this value instead of shipping a release.
#
#   [{"host":"www.site.example",
#     "id":"/video-([A-Za-z0-9]+)/",
#     "page":"https://www.site.example/embed/$1/",
#     "fid":"/thumbs/static\\d+/\\d+/\\d+/\\d+/(\\d+)/",
#     "media":"https://www.site.example/dload/$1/{h}/$2-{h}p.mp4",
#     "heights":[1080,720,480,360]}]
#
# Unset, no host behaves differently. It needs a working relay above to be
# reached at all, since the page it reads is itself behind the same block.
SCRAPE_SITE_RULES=

# Instagram `sessionid` cookie from a BURNER account. Only needed for
# login-gated posts; public reels/photos resolve without it.
#
# Setting this is NOT sufficient on its own: a request also needs the `ig`
# grant on its user row (migrations/0007), so an unlisted visitor never
# carries the cookie.
IG_SESSIONID=

# The companion cookies a real Instagram session carries. All optional, and
# all read from devtools > Application > Cookies on the browser that logged in
# — the same profile the IG_SESSIONID above came from.
#
# Why bother: a lone `sessionid` arriving from a datacenter IP is an anomaly on
# its own, because the real web client never sends one without these beside it.
# Filling them is the cheapest thing that extends how long a session survives
# before it is flagged. It does not make the session permanent; nothing does —
# the datacenter ASN is the dominant signal and no header changes it. Plan on
# rotating the session, and expect weeks rather than months.
#
# Mixing values from different browser profiles is worse than leaving them
# blank: a `mid` from one device beside a `sessionid` from another is a
# contradiction a single-device browser could never produce. An empty var is
# omitted from the header entirely rather than sent as `mid=`.
IG_CSRFTOKEN=
IG_DS_USER_ID=
IG_DID=
IG_MID=
IG_DATR=
IG_RUR=
# Viewport size, e.g. 1920x1080.
IG_WD=

# Upstash Redis REST credentials. Used to discover the self-hosted resolver's
# rotating Back4app URL (it self-registers on each /health ping).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared secret the resolver presents when self-registering its live URL.
REGISTRY_KEY=

# HMAC key for Pro access tokens and session cookies (WebCrypto HMAC-SHA256).
# Generate 32+ random bytes yourself:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Rotating this invalidates every issued token and session cookie at once —
# every signed-in user is forced to sign in again. Not something to do
# casually.
PRO_TOKEN_SECRET=

# Google OAuth client. Same values as .env.sample — see that file for how to
# obtain each one. Register BOTH redirect URIs at console.cloud.google.com:
# the wrangler dev origin and the production origin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Creem. The API key is required here too: it mints a fresh customer-portal
# URL on every "Manage billing" click (never stored) and backs the lazy
# subscription reconcile. A `creem_test_…` key routes to Creem's test host.
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
