{
  "name": "social-media-downloader",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "indexnow": "node scripts/indexnow.mjs",
    "icons": "node scripts/make-favicon.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "perf": "node scripts/perf-audit.mjs",
    "i18n:deep": "node scripts/i18n-deep.mjs",
    "i18n:lock": "cross-env I18N_LOCK=1 vitest run src/lib/localeContent.test.ts",
    "cf:build": "cross-env DEPLOY_TARGET=cloudflare next build && node scripts/cf-postbuild.mjs",
    "preview": "pnpm cf:build && wrangler dev",
    "deploy": "pnpm cf:build && wrangler deploy && node scripts/indexnow.mjs",
    "cf:startup": "node --experimental-vm-modules scripts/worker-startup.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:smoke": "node scripts/cf-smoke.mjs",
    "cf:setup": "node scripts/cf-setup.mjs",
    "cf:waf": "node scripts/cf-setup.mjs waf",
    "cf:health": "node scripts/cf-setup.mjs health",
    "fb:secret": "node scripts/fb-secret.mjs",
    "posthog:query": "node scripts/posthog-query.mjs",
    "posthog:issues": "node scripts/posthog-issues.mjs",
    "posthog:usage": "node scripts/posthog-usage.mjs",
    "posthog:setup": "node scripts/posthog-setup.mjs"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "clsx": "^2.1.1",
    "fluent-ffmpeg": "^2.1.3",
    "jszip": "^3.10.2",
    "motion": "^14.8.0",
    "next": "16.4.3",
    "posthog-js": "^1.442.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "youtube-dl-exec": "^3.1.19"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
