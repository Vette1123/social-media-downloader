{
  "name": "social-media-downloader",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "indexnow": "node scripts/indexnow.mjs",
    "sponsors:expire": "node scripts/expire-sponsors.mjs",
    "icons": "node scripts/make-favicon.mjs",
    "apps:icons": "node scripts/build-app-icons.mjs",
    "icons:bump": "node scripts/icon-version.mjs --bump",
    "start": "next start",
    "lint": "oxlint --report-unused-disable-directives --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "pro": "node scripts/grant-pro.mjs",
    "perf": "node scripts/perf-audit.mjs",
    "cls": "node scripts/cls-audit.mjs",
    "shots": "node scripts/ui-shots.mjs",
    "perf:idle": "node scripts/idle-paint-probe.mjs",
    "cls:flow": "node scripts/cls-flow.mjs",
    "inp:flow": "node scripts/inp-flow.mjs",
    "i18n:deep": "node scripts/i18n-deep.mjs",
    "i18n:lock": "cross-env I18N_LOCK=1 vitest run src/lib/localeContent.test.ts",
    "cf:build": "cross-env DEPLOY_TARGET=cloudflare next build && node scripts/cf-postbuild.mjs",
    "preview": "pnpm cf:build && wrangler dev",
    "deploy": "pnpm cf:build && node scripts/indexnow.mjs --plan .indexnow-plan.json && wrangler deploy && node scripts/indexnow.mjs --submit .indexnow-plan.json",
    "cf:startup": "node --experimental-vm-modules scripts/worker-startup.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:smoke": "node scripts/cf-smoke.mjs",
    "seo:verify": "node scripts/seo-verify.mjs",
    "seo:submit": "node scripts/indexnow.mjs --sitemaps",
    "seo:daily": "node scripts/seo-daily.mjs",
    "seo:gsc": "node scripts/seo-gsc.mjs",
    "cf:setup": "node scripts/cf-setup.mjs",
    "cf:waf": "node scripts/cf-setup.mjs waf",
    "cf:health": "node scripts/cf-setup.mjs health",
    "cf:tune": "node scripts/cf-setup.mjs tune",
    "fb:secret": "node scripts/fb-secret.mjs",
    "og:ar": "node scripts/og-ar.mjs",
    "og:preview": "node scripts/og-preview.mjs",
    "posthog:query": "node scripts/posthog-query.mjs",
    "posthog:issues": "node scripts/posthog-issues.mjs",
    "posthog:usage": "node scripts/posthog-usage.mjs",
    "posthog:setup": "node scripts/posthog-setup.mjs",
    "posthog:watch": "node scripts/posthog-watch.mjs",
    "telegram:setup": "node scripts/telegram-setup.mjs",
    "link:probe": "node scripts/link-probe.mjs",
    "seo:pending": "node scripts/seo-pending.mjs"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "clsx": "^2.1.1",
    "jszip": "^3.10.2",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "posthog-js": "^1.453.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "youtube-dl-exec": "^3.1.19"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "typescript6": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
